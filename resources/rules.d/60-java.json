    {
      "intent_id": "java.jar.nohup",
      "desc": "nohup 后台启动 jar（写日志与 PID）",
      "keywords": [
        "nohup",
        "nohup jar",
        "nohup启动jar",
        "后台启动jar",
        "后台跑jar",
        "后台运行jar",
        "nohup执行jar",
        "挂起跑jar",
        "jar后台",
        "启动jar后台"
      ],
      "weight": 12,
      "params": [
        {
          "name": "path",
          "required": true,
          "extract": "path"
        }
      ],
      "risk_level": "medium",
      "candidates": [
        {
          "kind": "sequence",
          "label": "nohup 启动 → 写 PID → 确认进程",
          "stop_on_error": true,
          "steps": [
            "mkdir -p \"$(dirname {path})/logs\" 2>/dev/null; true",
            "nohup java -jar {path} > \"$(dirname {path})/logs/app.log\" 2>&1 & echo $! | tee \"$(dirname {path})/app.pid\"",
            "sleep 1; ps -fp \"$(cat \"$(dirname {path})/app.pid\")\" 2>/dev/null || jps -l | grep -F \"$(basename {path})\""
          ]
        },
        {
          "kind": "single",
          "label": "简写：nohup 到 /tmp 日志",
          "cmd": "nohup java -jar {path} > /tmp/$(basename {path}).log 2>&1 & echo $!"
        }
      ],
      "tips": [
        "日志默认 jar 同级 logs/app.log，PID 写 app.pid；停服见「停止jar」或 stop 脚本",
        "生产更推荐 systemd 托管"
      ]
    },
    {
      "intent_id": "java.app.stop",
      "desc": "停止 Java / jar 进程",
      "keywords": [
        "停止jar",
        "停掉jar",
        "结束jar",
        "关掉java程序",
        "停止java程序",
        "停java应用",
        "kill jar",
        "关闭jar",
        "停止java应用"
      ],
      "weight": 11,
      "params": [
        {
          "name": "path",
          "required": false,
          "extract": "path"
        },
        {
          "name": "pid",
          "required": false,
          "extract": "pid"
        }
      ],
      "risk_level": "high",
      "candidates": [
        {
          "kind": "sequence",
          "label": "按 PID 文件优雅停止再强杀",
          "stop_on_error": false,
          "steps": [
            "kill \"$(cat \"$(dirname {path})/app.pid\")\"",
            "sleep 2",
            "kill -9 \"$(cat \"$(dirname {path})/app.pid\")\" 2>/dev/null; true"
          ]
        },
        {
          "kind": "sequence",
          "label": "按已知 PID：SIGTERM → SIGKILL",
          "stop_on_error": false,
          "steps": [
            "kill {pid}",
            "sleep 2",
            "kill -9 {pid} 2>/dev/null; true"
          ]
        },
        {
          "kind": "single",
          "label": "按 jar 名查找后提示（请改成真实 PID）",
          "cmd": "jps -l | grep -F \"$(basename {path})\"; ps aux | grep -F \"$(basename {path})\" | grep -v grep"
        }
      ],
      "tips": [
        "优先 PID 文件或 jps 确认后再 kill；勿盲目 kill -9"
      ]
    },
    {
      "intent_id": "java.app.scripts",
      "desc": "生成 jar 启停脚本 start.sh / stop.sh",
      "keywords": [
        "java启停脚本",
        "jar启动脚本",
        "jar停止脚本",
        "start.sh",
        "stop.sh",
        "生成启停脚本",
        "java启动脚本",
        "java停止脚本",
        "写启停脚本",
        "jar脚本"
      ],
      "weight": 12,
      "params": [
        {
          "name": "path",
          "required": true,
          "extract": "path"
        }
      ],
      "risk_level": "medium",
      "candidates": [
        {
          "kind": "sequence",
          "label": "从模板写出 start.sh / stop.sh 并 chmod",
          "stop_on_error": true,
          "steps": [
            "DIR=\"$(cd \"$(dirname {path})\" && pwd)\"; JAR_NAME=\"$(basename {path})\"; sed \"s|@JAR_NAME@|${JAR_NAME}|g\" \"{templates_root}/java/start.sh.tpl\" > \"$DIR/start.sh\"",
            "DIR=\"$(cd \"$(dirname {path})\" && pwd)\"; cp \"{templates_root}/java/stop.sh.tpl\" \"$DIR/stop.sh\"",
            "chmod +x \"$(dirname {path})/start.sh\" \"$(dirname {path})/stop.sh\" && ls -lah \"$(dirname {path})/start.sh\" \"$(dirname {path})/stop.sh\""
          ]
        },
        {
          "kind": "single",
          "label": "执行 start.sh",
          "cmd": "\"$(cd \"$(dirname {path})\" && pwd)/start.sh\""
        },
        {
          "kind": "single",
          "label": "执行 stop.sh",
          "cmd": "\"$(cd \"$(dirname {path})\" && pwd)/stop.sh\""
        }
      ],
      "tips": [
        "将 {path} 换成 jar 绝对路径；模板在 resources/templates/java/；再跑 start.sh / stop.sh"
      ]
    },
    {
      "intent_id": "java.systemd.unit",
      "desc": "把 jar 注册为 systemd 服务",
      "keywords": [
        "java systemd",
        "jar systemd",
        "java做成服务",
        "jar做成服务",
        "注册systemd",
        "java服务单元",
        "systemd托管java",
        "java unit",
        "把java放入systemd",
        "java开机自启",
        "jar开机自启",
        "systemd java"
      ],
      "weight": 13,
      "params": [
        {
          "name": "path",
          "required": true,
          "extract": "path"
        },
        {
          "name": "service",
          "required": false,
          "extract": "service"
        }
      ],
      "risk_level": "high",
      "candidates": [
        {
          "kind": "sequence",
          "label": "模板渲染 unit → reload → enable --now → status",
          "stop_on_error": true,
          "steps": [
            "JAR=\"$(readlink -f {path})\"; APP_HOME=\"$(dirname \"$JAR\")\"; SVC=\"{service}\"; [[ \"$SVC\" == \"{service}\" || -z \"$SVC\" ]] && SVC=\"$(basename \"$JAR\" .jar)\"; JAVA_BIN=\"$(command -v java)\"; UNIT=\"/etc/systemd/system/${SVC}.service\"; sed -e \"s|@SERVICE@|${SVC}|g\" -e \"s|@APP_HOME@|${APP_HOME}|g\" -e \"s|@JAVA_BIN@|${JAVA_BIN}|g\" -e \"s|@JAR@|${JAR}|g\" \"{templates_root}/java/app.service.tpl\" | sudo tee \"$UNIT\" >/dev/null; echo \"wrote $UNIT\"",
            "sudo systemctl daemon-reload",
            "JAR=\"$(readlink -f {path})\"; SVC=\"{service}\"; [[ \"$SVC\" == \"{service}\" || -z \"$SVC\" ]] && SVC=\"$(basename \"$JAR\" .jar)\"; sudo systemctl enable --now \"$SVC\"",
            "JAR=\"$(readlink -f {path})\"; SVC=\"{service}\"; [[ \"$SVC\" == \"{service}\" || -z \"$SVC\" ]] && SVC=\"$(basename \"$JAR\" .jar)\"; systemctl status \"$SVC\" --no-pager"
          ]
        },
        {
          "kind": "single",
          "label": "预览建议的 unit 名与 ExecStart（不写入）",
          "cmd": "echo \"unit=/etc/systemd/system/$(basename {path} .jar).service\"; echo \"ExecStart=$(command -v java) -jar $(readlink -f {path})\"; echo \"template={templates_root}/java/app.service.tpl\""
        }
      ],
      "tips": [
        "默认服务名=jar 名（去 .jar）；口语里可带服务名供提取；需 sudo",
        "日常：systemctl stop|start|restart <名>；日志：journalctl -u <名> -f"
      ]
    },
