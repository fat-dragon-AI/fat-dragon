{
  "set": "60-java",
  "desc": "Java / JVM / JDK",
  "rules": [
    {
      "intent_id": "jvm.jps",
      "desc": "列出 Java 进程",
      "keywords": [
        "jps",
        "java进程",
        "有哪些java",
        "jvm进程",
        "看java进程",
        "列出java",
        "java pid",
        "查找java进程",
        "找java进程",
        "查java进程",
        "java进程有哪些",
        "运维java进程"
      ],
      "weight": 12,
      "risk_level": "low",
      "candidates": [
        {
          "kind": "sequence",
          "label": "jps 优先，再用 ps 兜底",
          "stop_on_error": false,
          "steps": [
            "jps -lvm",
            "jps -l",
            "ps aux | grep -i '[j]ava'"
          ]
        }
      ],
      "tips": [
        "需 JDK/JRE 在 PATH；无 jps 时看第三条 ps；也可用意图「ps找java」"
      ]
    },
    {
      "intent_id": "jvm.jstat.gc",
      "desc": "查看 JVM GC 情况",
      "keywords": [
        "jstat",
        "gc情况",
        "看gc",
        "垃圾回收",
        "jvm gc",
        "gc"
      ],
      "weight": 10,
      "params": [
        {
          "name": "pid",
          "required": true,
          "extract": "pid"
        }
      ],
      "risk_level": "low",
      "cmd_template": [
        "jstat -gcutil {pid} 1000 10",
        "jstat -gc {pid} 1000 5"
